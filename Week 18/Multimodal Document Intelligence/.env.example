# Application
APP_NAME=Multimodal Document Intelligence
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Vision provider: "mock" or "openai"
VISION_PROVIDER=mock

# OpenAI configuration
# Add the real key only inside a local .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=120

# PDF processing
PDF_RENDER_DPI=150
MAX_PDF_PAGES=50
MAX_UPLOAD_SIZE_MB=25

# Extraction
MIN_CONFIDENCE=0.50
SAVE_PAGE_IMAGES=true
SAVE_EXTRACTION_RESULTS=true

# Project directories
SAMPLE_DOCUMENTS_DIR=data/sample_documents
SAMPLE_PAGES_DIR=data/sample_pages
GROUND_TRUTH_DIR=data/ground_truth
EXTRACTIONS_DIR=outputs/extractions
COMPARISONS_DIR=outputs/comparisons
REPORTS_DIR=outputs/reports