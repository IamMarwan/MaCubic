# ============================================================
# CubicDocs AI - Environment Configuration
# ============================================================

APP_NAME=CubicDocs AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# Security
# Generate a stronger value before production deployment.
# ------------------------------------------------------------

SECRET_KEY=replace-this-with-a-long-random-production-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# Database
# SQLite works for local development.
# Docker will later use PostgreSQL.
# ------------------------------------------------------------

DATABASE_URL=sqlite:///./cubicdocs.db

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://cubicdocs:cubicdocs@database:5432/cubicdocs

# ------------------------------------------------------------
# Redis and worker
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# File storage
# ------------------------------------------------------------

DOCUMENT_STORAGE_PATH=../data/documents
EXPORT_STORAGE_PATH=../data/exports
BACKUP_STORAGE_PATH=../data/backups

MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_EXTENSIONS=.pdf,.docx,.txt,.md

# ------------------------------------------------------------
# AI and retrieval
# ------------------------------------------------------------

AI_PROVIDER=local
AI_API_KEY=
EMBEDDING_MODEL=local-tfidf
TOP_K_RESULTS=5
MIN_RELEVANCE_SCORE=0.10

# ------------------------------------------------------------
# Logging and monitoring
# ------------------------------------------------------------

LOG_LEVEL=INFO
ENABLE_METRICS=true