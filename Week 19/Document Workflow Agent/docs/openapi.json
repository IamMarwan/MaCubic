{
  "openapi": "3.1.0",
  "info": {
    "title": "Document Workflow Agent",
    "version": "1.0.0",
    "description": "Week 19 local standalone orchestration service. Eight tools, explicit indexing and persistent event history."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Inspect service mode",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Run not found"
          }
        }
      }
    },
    "/api/v1/tools": {
      "get": {
        "summary": "List the eight available tools",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Run not found"
          }
        }
      }
    },
    "/api/v1/samples": {
      "get": {
        "summary": "List fictional training samples",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Run not found"
          }
        }
      }
    },
    "/api/v1/runs": {
      "get": {
        "summary": "List execution history",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Run not found"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ]
      },
      "post": {
        "summary": "Run the agent synchronously",
        "description": "Send JSON containing text or base64, or raw file bytes with filename and task query parameters. A recorded agent run may be completed, failed or halted; inspect status.",
        "parameters": [
          {
            "name": "filename",
            "in": "query",
            "description": "Required for raw uploads",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "task",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "workflow",
                "review",
                "classify",
                "summarize",
                "revisions"
              ],
              "default": "workflow"
            }
          },
          {
            "name": "instruction",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2000
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submission"
              }
            },
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/pdf": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run recorded or document indexed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Cross-origin submission"
          },
          "408": {
            "description": "Upload timed out"
          },
          "429": {
            "description": "Submission capacity reached"
          },
          "500": {
            "description": "Service failure"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}": {
      "get": {
        "summary": "Retrieve a run with results and events",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Run not found"
          }
        },
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/runs/{run_id}/events": {
      "get": {
        "summary": "Retrieve the ordered execution log",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Run not found"
          }
        },
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/documents/index": {
      "post": {
        "summary": "Explicitly index a prior document revision",
        "description": "Send JSON containing text or base64, or raw file bytes with filename and task query parameters. A recorded agent run may be completed, failed or halted; inspect status.",
        "parameters": [
          {
            "name": "filename",
            "in": "query",
            "description": "Required for raw uploads",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "task",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "workflow",
                "review",
                "classify",
                "summarize",
                "revisions"
              ],
              "default": "workflow"
            }
          },
          {
            "name": "instruction",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2000
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submission"
              }
            },
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/pdf": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Run recorded or document indexed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Cross-origin submission"
          },
          "408": {
            "description": "Upload timed out"
          },
          "429": {
            "description": "Submission capacity reached"
          },
          "500": {
            "description": "Service failure"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Submission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 180
          },
          "text": {
            "type": "string"
          },
          "content_base64": {
            "type": "string"
          },
          "task": {
            "type": "string",
            "enum": [
              "workflow",
              "review",
              "classify",
              "summarize",
              "revisions"
            ],
            "default": "workflow"
          },
          "instruction": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "oneOf": [
          {
            "required": [
              "text"
            ],
            "not": {
              "required": [
                "content_base64"
              ]
            }
          },
          {
            "required": [
              "content_base64"
            ],
            "not": {
              "required": [
                "text"
              ]
            }
          }
        ]
      }
    }
  }
}