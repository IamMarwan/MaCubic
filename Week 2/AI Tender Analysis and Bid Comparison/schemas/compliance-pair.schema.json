{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bidder requirement compliance decision",
  "type": "object",
  "required": ["pair_id", "bidder", "requirement_id", "requirement", "category", "mandatory", "status", "tender_reference", "bid_evidence", "rationale", "unresolved_question", "searched_documents", "finding_flags", "mandatory_gap"],
  "properties": {
    "pair_id": {"type": "string"},
    "bidder": {"type": "string"},
    "requirement_id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"},
    "requirement": {"type": "string"},
    "category": {"type": "string"},
    "mandatory": {"type": "boolean"},
    "status": {"enum": ["met", "partially met", "not met", "not evidenced", "not applicable"]},
    "tender_reference": {"$ref": "#/$defs/source"},
    "bid_evidence": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "rationale": {"type": "string"},
    "unresolved_question": {"type": "string"},
    "searched_documents": {"type": "array", "items": {"type": "string"}},
    "finding_flags": {"type": "array", "items": {"type": "string"}},
    "mandatory_gap": {"type": "boolean"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["file", "page", "quotation"],
      "properties": {
        "file": {"type": "string"},
        "page": {"type": "integer", "minimum": 1},
        "quotation": {"type": "string", "minLength": 1},
        "mapping_method": {"type": "string"},
        "mapping_score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
